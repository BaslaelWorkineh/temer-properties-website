# Canonical public origin, no trailing slash. REQUIRED for production builds:
# canonical URLs, sitemap, robots.txt, Open Graph and JSON-LD are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite file (local / single VPS) or libsql://<db>.turso.io (serverless).
DATABASE_URL=file:./data/temer.db
DATABASE_AUTH_TOKEN=

# Uploaded images. Must be persistent disk (not ephemeral serverless storage).
UPLOAD_DIR=./storage/uploads

# true on staging/preview deployments: adds noindex everywhere + blocks robots.
SITE_NOINDEX=false

# Search engine verification codes (Google Search Console, Bing Webmaster Tools, Yandex).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Optional: Telegram alerts for new bookings and enquiries.
# Create a bot with @BotFather, add it to your sales group, put the group chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# First admin account, created by `npm run db:seed` when no admin exists.
ADMIN_EMAIL=admin@temerproperties.local
ADMIN_PASSWORD=
