# Canonical public origin, no trailing slash. REQUIRED for production builds:
# canonical URLs, sitemap, robots.txt, Open Graph and JSON-LD are built from it.
# Production: https://www.temerpropertiesethiopia.com (with www; the host redirects the bare domain to it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Neon). Use the pooled connection string (host contains "-pooler").
# Production: the Neon production branch. Local development: a separate dev branch.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Uploaded images on a local/VPS disk. Must be persistent (not ephemeral serverless storage).
UPLOAD_DIR=./storage/uploads
# Vercel: connect a Blob store to the project and Vercel adds this; uploads then go to Vercel Blob instead of UPLOAD_DIR.
BLOB_READ_WRITE_TOKEN=

# true on staging/preview deployments: adds noindex everywhere + blocks robots.
SITE_NOINDEX=false

# Search engine verification codes (Google Search Console, Bing Webmaster Tools, Yandex).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# First admin account, created by `npm run db:seed` when no admin exists.
ADMIN_EMAIL=admin@temerproperties.local
ADMIN_PASSWORD=
